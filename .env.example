# Cloudflare Access (production admin API authentication)
# Team domain only, without https:// or a trailing slash.
NUXT_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# Application Audience (AUD) from your Cloudflare Access application.
NUXT_ACCESS_AUDIENCE=your-access-application-aud

# pnpm dev skips Access authentication; these values are not needed locally.
# For deployment, set both variables in the Worker runtime environment.
